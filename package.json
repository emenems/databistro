    "@headlessui/tailwindcss": "^0.2.0",
    "@remixicon/react": "^4.9.0",
    "@tremor/react": "^3.17.4",
    "@types/react-dom": "^19.3.0",
    "@vercel/analytics": "^2.0.1",
    "autoprefixer": "10.4.14",
    "classnames": "^2.5.1",
    "concurrently": "^8.0.1",
    "country-flag-icons": "^1.6.20",
    "date-fns": "^3.3.1",
    "gray-matter": "^4.0.3",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.5.0",
    "react-simple-maps": "^5.0.5",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "tailwindcss": "^3.4.3",
    "use-debounce": "^9.0.4"
  },
  "devDependencies": {
